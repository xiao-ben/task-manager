# Required. Use a long random string in production.
TASK_MANAGER_TOKEN=dev-token-change-me

# Local development: leave DATABASE_URL unset to use an in-memory store.
# Production: Postgres (e.g. Neon).
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# USE_MEMORY_DB=1

# Optional: AI day/week/month summaries
# AI_GATEWAY_API_KEY=
# OPENAI_API_KEY=
# AI_SUMMARY_MODEL=
# AI_SUMMARY_ENDPOINT=
